# 复制为 infra.local.env 后按本机修改（infra.local.env 不提交）
# Windows Git Bash / macOS / Linux 共用

# MySQL：默认用本机已安装实例
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=ting

# Redis：Windows 填安装目录（含 redis-server.exe）；留空则尝试常见路径
REDIS_HOME=
REDIS_PORT=6379

# Nacos：首次 start-infra 会自动下载到项目 tools/nacos
NACOS_VERSION=2.3.2
NACOS_HOME=
NACOS_PORT=8848
